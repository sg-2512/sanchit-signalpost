# Google Cloud API Keys (Optional enhancements for external footprint scoring)
# 1. Google Places API key (fetches ratings, reviews, place data)
GOOGLE_PLACES_API_KEY=

# 2. YouTube Data API v3 key (fetches company channel stats, subscriber count, views)
