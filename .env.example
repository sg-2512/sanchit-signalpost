# Core External Intelligence API Keys
# 1. Google Places API key (fetches ratings, reviews, place data, and websiteUri)
GOOGLE_PLACES_API_KEY=

# 2. YouTube Data API v3 key (fetches company channel stats, subscriber count, views)
YOUTUBE_API_KEY=

# 3. Brave Search API key (discovers candidate company domains omitted from registry)
BRAVE_API_KEY=

# 4. OpenAI API Key & Model (for LLM-based executive synthesis)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 5. Patentstyret API key (Norwegian Industrial Property Office - trademarks & patents)
PATENTSTYRET_API_KEY=
